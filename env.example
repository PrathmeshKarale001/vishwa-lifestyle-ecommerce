# ===========================================
# VISHWA LIFESTYLE - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git!

# ===========================================
# APP CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production: https://vishwalifestyle.com

# ===========================================
# SUPABASE (Database & Auth)
# ===========================================
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===========================================
# SANITY CMS
# ===========================================
# Get these from: https://sanity.io/manage → Your Project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-11-28
# Get token from: https://sanity.io/manage → API → Tokens (Editor permissions)
SANITY_API_TOKEN=your_sanity_token_here

# ===========================================
# RAZORPAY (Payments)
# ===========================================
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
# For development: Use TEST keys (rzp_test_...)
# For production: Use LIVE keys (rzp_live_...) after KYC completion
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_secret_here
# Get from: Settings → Webhooks → Webhook Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ===========================================
# EMAIL SERVICE (Resend)
# ===========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# Use your verified domain or Resend's default: onboarding@resend.dev
RESEND_FROM_EMAIL=Vishwa Lifestyle <noreply@vishwalifestyle.com>
# Admin email for notifications
ADMIN_EMAIL=admin@vishwalifestyle.com

# ===========================================
# GOOGLE OAUTH (Social Login)
# ===========================================
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===========================================
# ADMIN ACCESS
# ===========================================
# Comma-separated list of admin emails
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=admin@vishwalifestyle.com

# ===========================================
# ANALYTICS (Optional)
# ===========================================
# Get from: https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# SENTRY (Error Monitoring - Optional)
# ===========================================
# Get from: https://sentry.io → Settings → Projects → Client Keys
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ===========================================
# SHIPROCKET (Shipping - Optional)
# ===========================================
# Get from: https://shiprocket.in → Settings → API
SHIPROCKET_EMAIL=your_email@example.com
SHIPROCKET_PASSWORD=your_password

# ===========================================
# NOTES
# ===========================================
# 1. Never commit this file with real values
# 2. For production, use LIVE keys (not test)
# 3. Update NEXT_PUBLIC_APP_URL to your production domain
# 4. Verify all redirect URLs in service dashboards
# 5. Test everything in test mode before going live

